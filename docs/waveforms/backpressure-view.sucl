# Surfer 0.6 view: master-0 AXI4-Lite channels of the backpressure test
# (the waveform behind docs/screenshots/08-waveform.png)
#
#   surfer -c docs/waveforms/backpressure-view.sucl docs/waveforms/crossbar-backpressure-seed1.vcd
#
variable_add crossbar_checker_top.m_axil_awvalid
variable_add crossbar_checker_top.m_axil_awready
variable_add crossbar_checker_top.m_axil_wvalid
variable_add crossbar_checker_top.m_axil_wready
variable_add crossbar_checker_top.m_axil_bvalid
variable_add crossbar_checker_top.m_axil_bready
variable_add crossbar_checker_top.m_axil_arvalid
variable_add crossbar_checker_top.m_axil_arready
variable_add crossbar_checker_top.m_axil_rvalid
variable_add crossbar_checker_top.m_axil_rready
zoom_to 0ns 1560ns
